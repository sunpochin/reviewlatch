{
  "name": "reviewlatch",
  "version": "0.2.0",
  "description": "Review-aware delivery gates for coding agents",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/sunpochin/reviewlatch.git" },
  "bin": { "reviewlatch": "src/cli.ts" },
  "exports": "./src/index.ts",
  "files": ["src", "examples", "docs", "action.yml", "AGENTS.md", "TECHNICAL.md", "CHANGELOG.md", "README.md", "README.zh-TW.md", "LICENSE", "NOTICE.md"],
  "engines": { "bun": ">=1.4.2" },
  "scripts": {
    "test": "bun test --isolate tests",
    "test:unit": "bun test --isolate tests/unit",
    "demo": "bun --no-env-file src/cli.ts check --config examples/reviewlatch.json --snapshot examples/ready.json",
    "check": "bun --no-env-file src/cli.ts"
  }
}
